<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<OutputType>WinExe</OutputType>

		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<RootNamespace>KeyFix</RootNamespace>

		<ApplicationManifest>app.manifest</ApplicationManifest>

		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

		<!-- Runtime identifier follows the selected platform (x64 when none is set). -->
		<KeyFixRid>win-x64</KeyFixRid>
		<KeyFixRid Condition="'$(Platform)' == 'x86'">win-x86</KeyFixRid>
		<KeyFixRid Condition="'$(Platform)' == 'ARM64'">win-arm64</KeyFixRid>
		<RuntimeIdentifier>$(KeyFixRid)</RuntimeIdentifier>

		<UseWinUI>true</UseWinUI>
		<WinUISDKReferences>false</WinUISDKReferences>

		<WindowsPackageType>None</WindowsPackageType>

		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<SelfContained>true</SelfContained>

		<EnableMsixTooling>true</EnableMsixTooling>

		<Nullable>enable</Nullable>

		<ApplicationIcon>KeyFix.ico</ApplicationIcon>

		<ApplicationTitle>KeyFix</ApplicationTitle>
		<Company>M-D-6</Company>
		<Product>KeyFix</Product>
		<Authors>M-D-6</Authors>
		<Description>Keyboard layout text conversion utility.</Description>
		<Copyright>Copyright © 2026 M-D-6</Copyright>
		<AssemblyVersion>1.0.1.0</AssemblyVersion>
		<FileVersion>1.0.1.0</FileVersion>
		<InformationalVersion>1.0.1</InformationalVersion>
		<RepositoryUrl>https://github.com/M-D-6/KeyFix</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<SatelliteResourceLanguages>en-US;fa-IR</SatelliteResourceLanguages>
		<ResourceLanguages>en-US;fa-IR</ResourceLanguages>

	</PropertyGroup>

	<ItemGroup>

		<Content Include="KeyFix.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

	</ItemGroup>

	<ItemGroup>

		<Manifest Include="$(ApplicationManifest)" />

	</ItemGroup>

	<ItemGroup>

		<PackageReference
			Include="Microsoft.Windows.SDK.BuildTools"
			Version="10.0.28000.2526" />

		<PackageReference
			Include="Microsoft.WindowsAppSDK"
			Version="2.4.0" />

		<PackageReference
			Include="H.NotifyIcon.WinUI"
			Version="2.4.1" />

		<PackageReference
			Update="Microsoft.WindowsAppSDK.AI"
			ExcludeAssets="all" />

		<PackageReference
			Update="Microsoft.WindowsAppSDK.ML"
			ExcludeAssets="all" />

	</ItemGroup>

	<PropertyGroup>

		<RuntimeIdentifier>$(KeyFixRid)</RuntimeIdentifier>

		<SelfContained>true</SelfContained>

		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<DebugType>None</DebugType>

		<DebugSymbols>false</DebugSymbols>

		<PublishReadyToRun>false</PublishReadyToRun>

		<PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>

		<PublishTrimmed>false</PublishTrimmed>

		<PublishSingleFile>false</PublishSingleFile>

		<SatelliteResourceLanguages>
			en-US;fa-IR
		</SatelliteResourceLanguages>

		<ResourceLanguages>
			en-US;fa-IR
		</ResourceLanguages>

		<PublishDir>$(MSBuildProjectDirectory)\publish\$(KeyFixRid)\</PublishDir>

	</PropertyGroup>


	<Target Name="RemoveUnusedWindowsMLBinaries"
        AfterTargets="CleanupPublishLanguages">

		<ItemGroup>

			<UnusedFiles Include="$(PublishDir)\onnxruntime.dll"
						Condition="Exists('$(PublishDir)\onnxruntime.dll')" />

			<UnusedFiles Include="$(PublishDir)\Microsoft.ML.OnnxRuntime.dll"
						Condition="Exists('$(PublishDir)\Microsoft.ML.OnnxRuntime.dll')" />

			<UnusedFiles Include="$(PublishDir)\runtimes\$(KeyFixRid)\native\onnxruntime.dll"
						Condition="Exists('$(PublishDir)\runtimes\$(KeyFixRid)\native\onnxruntime.dll')" />

			<UnusedFiles Include="$(PublishDir)\DirectML.dll"
						Condition="Exists('$(PublishDir)\DirectML.dll')" />

			<UnusedFiles Include="$(PublishDir)\runtimes\$(KeyFixRid)\native\DirectML.dll"
						Condition="Exists('$(PublishDir)\runtimes\$(KeyFixRid)\native\DirectML.dll')" />

			<UnusedFiles Include="$(PublishDir)\Microsoft.Windows.AI.*.dll"
						Condition="Exists('$(PublishDir)\Microsoft.Windows.AI.*.dll')" />

			<UnusedFiles Include="$(PublishDir)\NPUDetect.dll"
						Condition="Exists('$(PublishDir)\NPUDetect.dll')" />

			<UnusedFiles Include="$(PublishDir)\PerceptiveStreaming.dll"
						Condition="Exists('$(PublishDir)\PerceptiveStreaming.dll')" />

			<UnusedFiles Include="$(PublishDir)\RestartAgent.exe"
						Condition="Exists('$(PublishDir)\RestartAgent.exe')" />

			<UnusedFiles Include="$(PublishDir)\SessionHandleIPCProxyStub.dll"
						Condition="Exists('$(PublishDir)\SessionHandleIPCProxyStub.dll')" />

			<UnusedFiles Include="$(PublishDir)\workloads*.json"
						Condition="Exists('$(PublishDir)\workloads*.json')" />

		</ItemGroup>

		<Delete Files="@(UnusedFiles)" />

	</Target>

</Project>